[Unit]
Description=Fieldstation smooth volume-dependent bass control
After=fieldstation-audio-dsp.service wireplumber.service
Requires=fieldstation-audio-dsp.service
[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/fieldstation-loudness.py
Restart=on-failure
RestartSec=3
[Install]
WantedBy=default.target
